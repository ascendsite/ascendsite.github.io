<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Teams - Ascend SMP</title>
    <link rel="stylesheet" href="style.css">
    <style>
        body {
            overflow: auto;
        }

        .teams-container {
            margin-top: 6rem;
            padding: 2rem 3rem;
            max-width: 800px;
            margin-left: auto;
            margin-right: auto;
        }

        .teams-container h2 {
            color: #b388ff;
            font-size: 2rem;
            margin-bottom: 2rem;
            text-align: center;
        }

        .team-card {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 1rem;
            backdrop-filter: blur(10px);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .team-card h3 {
            color: #ffffff;
            font-size: 1.3rem;
            margin-bottom: 0.3rem;
        }

        .team-card p {
            color: rgba(255, 255, 255, 0.5);
            font-size: 0.85rem;
        }

        .info-btn {
            color: #ffffff;
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 600;
            padding: 0.5rem 1.2rem;
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            cursor: pointer;
            transition: all 0.3s ease;
            letter-spacing: 1px;
            font-family: inherit;
        }

        .info-btn:hover {
            background: #b388ff;
            border-color: #b388ff;
            transform: translateY(-2px);
        }

        /* ── Modal ── */
        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(4px);
            z-index: 100;
            justify-content: center;
            align-items: center;
            animation: fadeIn 0.2s ease;
        }

        .modal-overlay.active {
            display: flex;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .modal {
            background: #12122a;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 2rem;
            max-width: 500px;
            width: 90%;
            max-height: 80vh;
            overflow-y: auto;
            position: relative;
            animation: modalSlideIn 0.3s ease;
        }

        @keyframes modalSlideIn {
            from {
                opacity: 0;
                transform: scale(0.9) translateY(20px);
            }
            to {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }

        .modal h2 {
            color: #b388ff;
            font-size: 1.6rem;
            margin-bottom: 1.5rem;
        }

        .modal-close {
            position: absolute;
            top: 1rem;
            right: 1rem;
            background: none;
            border: none;
            color: rgba(255, 255, 255, 0.4);
            font-size: 1.5rem;
            cursor: pointer;
            transition: color 0.2s ease;
        }

        .modal-close:hover {
            color: #ffffff;
        }

        .info-section {
            margin-bottom: 1.25rem;
        }

        .info-section:last-child {
            margin-bottom: 0;
        }

        .info-label {
            color: rgba(255, 255, 255, 0.4);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 0.4rem;
        }

        .info-value {
            color: #ffffff;
            font-size: 1rem;
        }

        .info-players {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-top: 0.3rem;
        }

        .info-player {
            background: rgba(179, 136, 255, 0.15);
            color: #b388ff;
            padding: 0.3rem 0.8rem;
            border-radius: 6px;
            font-size: 0.85rem;
        }

        .search-container {
            margin-bottom: 2rem;
        }

        .search-container input {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.05);
            color: #ffffff;
            font-size: 0.95rem;
            font-family: inherit;
            backdrop-filter: blur(10px);
            outline: none;
            transition: all 0.3s ease;
        }

        .search-container input:focus {
            border-color: #b388ff;
            box-shadow: 0 0 15px rgba(179, 136, 255, 0.3);
        }

        .search-container input::placeholder {
            color: rgba(255, 255, 255, 0.4);
        }

        .rank-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 2.5rem;
            height: 2.5rem;
            border-radius: 50%;
            font-size: 1.1rem;
            font-weight: 700;
            margin-right: 0.5rem;
            flex-shrink: 0;
            background: #b388ff;
            color: #ffffff;
            box-shadow: 0 0 12px rgba(179, 136, 255, 0.5);
            transform: translateX(-3px);
        }

        .rank-1 { background: linear-gradient(135deg, #ffd700, #ffed4e); color: #1a1a1a; box-shadow: 0 0 20px rgba(255, 215, 0, 0.6); }
        .rank-2 { background: linear-gradient(135deg, #c0c0c0, #e8e8e8); color: #1a1a1a; box-shadow: 0 0 16px rgba(192, 192, 192, 0.5); }
        .rank-3 { background: linear-gradient(135deg, #cd7f32, #daa06d); color: #1a1a1a; box-shadow: 0 0 16px rgba(205, 127, 50, 0.5); }

        .team-header {
            display: flex;
            align-items: center;
        }

        .team-points {
            color: #b388ff;
            font-size: 1.1rem;
            font-weight: 600;
            white-space: nowrap;
        }

    </style>
</head>
<body>
    <div class="top-bar">
        <h1 class="title">Ascend SMP</h1>
        <div class="nav-links">
            <a href="home" class="nav-btn">Home</a>
            <a href="https://discord.gg/3hVn6jbUfm" class="discord-link" target="_blank" rel="noopener noreferrer">Discord</a>
        </div>
    </div>

    <div class="teams-container">
        <h2>Teams</h2>
        <div class="search-container">
            <input type="text" id="search-input" placeholder="Search teams..." />
        </div>
    </div>

    <div class="modal-overlay" id="modal">
        <div class="modal">
            <button class="modal-close" onclick="closeModal()">&times;</button>
            <h2 id="modal-title">Team Name</h2>

            <div class="info-section">
                <div class="info-label">Points</div>
                <div class="info-value" id="modal-points">0.0 pts</div>
            </div>

            <div class="info-section">
                <div class="info-label">Description</div>
                <div class="info-value" id="modal-desc">Team description goes here.</div>
            </div>

            <div class="info-section">
                <div class="info-label">Created</div>
                <div class="info-value" id="modal-created">January 1, 2026</div>
            </div>

            <div class="info-section">
                <div class="info-label">Leader</div>
                <div class="info-value" id="modal-leader">PlayerName</div>
            </div>

            <div class="info-section">
                <div class="info-label">Members</div>
                <div class="info-players" id="modal-players">
                    <span class="info-player">Player1</span>
                    <span class="info-player">Player2</span>
                    <span class="info-player">Player3</span>
                </div>
            </div>

        </div>
    </div>

    <script>
        const API_URL = 'http://209.102.254.95:8081';
        let teamsData = [];

        async function loadTeams() {
            try {
                const res = await fetch(API_URL + '/api/teams');
                teamsData = await res.json();
                renderTeams();
            } catch (e) {
                document.querySelector('.teams-container').innerHTML +=
                    '<p style="text-align:center;color:rgba(255,255,255,0.4);margin-top:2rem;">Error: Plugin API offline please create a ticket on discord.</p>';
            }
        }

        function renderTeams() {
            const container = document.querySelector('.teams-container');
            document.querySelectorAll('.team-card').forEach(el => el.remove());
            const existingMsg = document.getElementById('no-results-msg');
            if (existingMsg) existingMsg.remove();

            const searchTerm = document.getElementById('search-input').value.toLowerCase();
            let filteredTeams = teamsData;

            if (searchTerm) {
                filteredTeams = teamsData.filter(team => 
                    team.name.toLowerCase().includes(searchTerm) ||
                    team.description.toLowerCase().includes(searchTerm) ||
                    team.leader.toLowerCase().includes(searchTerm)
                );
            }

            if (filteredTeams.length === 0) {
                const noResults = document.createElement('p');
                noResults.id = 'no-results-msg';
                noResults.style.cssText = 'text-align:center;color:rgba(255,255,255,0.4);margin-top:2rem;';
                noResults.textContent = searchTerm ? 'No teams match your search.' : 'No teams yet.';
                container.appendChild(noResults);
                return;
            }

            filteredTeams.sort((a, b) => b.points - a.points);

            filteredTeams.forEach((team, index) => {
                const originalIndex = teamsData.indexOf(team);
                const card = document.createElement('div');
                card.className = 'team-card';
                card.dataset.team = originalIndex;

                const rank = index + 1;
                let rankClass = '';
                if (rank === 1) rankClass = 'rank-1';
                else if (rank === 2) rankClass = 'rank-2';
                else if (rank === 3) rankClass = 'rank-3';
                card.innerHTML = `
                    <div class="team-header">
                        <span class="rank-badge ${rankClass}">${rank}</span>
                        <div>
                            <h3>${escapeHtml(team.name)}</h3>
                            <p>${escapeHtml(team.description)}</p>
                        </div>
                    </div>
                    <div style="display:flex;align-items:center;gap:1rem;">
                        <span class="team-points">${formatPoints(team.points)} pts</span>
                        <button class="info-btn" onclick="openModal(${originalIndex})">Team Info</button>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function formatPoints(points) {
            if (points % 1 === 0) {
                return points.toString();
            }
            return points.toFixed(1);
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function openModal(index) {
            const team = teamsData[index];
            document.getElementById('modal-title').textContent = team.name;
            document.getElementById('modal-points').textContent = formatPoints(team.points) + ' pts';
            document.getElementById('modal-desc').textContent = team.description;
            document.getElementById('modal-created').textContent = team.created;
            document.getElementById('modal-leader').textContent = team.leader;

            const playersContainer = document.getElementById('modal-players');
            playersContainer.innerHTML = '';
            const members = team.players.filter(p => p !== team.leader);
            if (members.length === 0) {
                const span = document.createElement('span');
                span.className = 'info-player';
                span.textContent = 'No members';
                playersContainer.appendChild(span);
            } else {
                members.forEach(p => {
                    const span = document.createElement('span');
                    span.className = 'info-player';
                    span.textContent = p;
                    playersContainer.appendChild(span);
                });
            }

            document.getElementById('modal').classList.add('active');
        }

        function closeModal() {
            document.getElementById('modal').classList.remove('active');
        }

        document.getElementById('modal').addEventListener('click', function(e) {
            if (e.target === this) closeModal();
        });

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') closeModal();
        });

        document.getElementById('search-input').addEventListener('input', renderTeams);

        loadTeams();
    </script>
</body>
</html>